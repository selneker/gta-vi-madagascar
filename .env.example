# ┌─────────────────────────────────────────────────────────────┐
# │ GTA VI MADAGASCAR — environment configuration               │
# │ Copy to .env and fill in real values before first launch.   │
# │ Never commit real tokens or credentials to version control. │
# └─────────────────────────────────────────────────────────────┘

# --- Discord ---
# Bot token from the Discord Developer Portal (Bot tab → Reset token)
DISCORD_TOKEN=your_bot_token_here
# Application (client) ID, used for slash-command registration
DISCORD_CLIENT_ID=your_application_id_here
# Target guild ID where the server structure is provisioned
DISCORD_GUILD_ID=your_guild_id_here
# Register commands globally instead of guild-only (slower propagation, production only)
DISCORD_GLOBAL_COMMANDS=false

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://gta_madagascar:password@localhost:5432/gta_madagascar?schema=public"

# --- Redis (optional — only enable when a justified use case appears) ---
REDIS_URL=redis://localhost:6379

# --- Application ---
NODE_ENV=development
LOG_LEVEL=debug
# HTTP health endpoint port (Render injects PORT automatically; leave unset locally to disable)
# PORT=3000
# Display timezone for all user-facing times (Per the project spec: Africa/Antananarivo)
TIMEZONE=Africa/Antananarivo
