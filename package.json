    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
